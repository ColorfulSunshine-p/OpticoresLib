{
  "schemaVersion": 1,
  "id": "opticoreslib",
  "version": "${version}",
  "name": "OptiCoresLib",
  "description": "Shared processing infrastructure for OptiCores and other mods: bounded task scheduling, managed worker pools, resource capability snapshots, local metrics and optional capability discovery. Contains no gameplay policy and no optional mod integrations.",
  "authors": [
    "Colorfulsunshine & Lilbroskato"
  ],
  "contact": {
    "sources": "https://github.com/anibalmolina-debug/OpticoresLib"
  },
  "license": "MIT",
  "icon": "assets/opticoreslib/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.opticoreslib.fabric.OpticoresLib"
    ],
    "client": [
      "com.opticoreslib.fabric.OpticoresLibClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": ">=0.116.17+1.21.1",
    "minecraft": ">=1.21.1 <=1.21.11",
    "java": ">=21"
  },
  "suggests": {
    "opticores": "*"
  }
}
